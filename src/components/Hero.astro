---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
  badge?: string;
  image?: string;
  stats?: { value: string; label: string }[];
}

const {
  title,
  subtitle,
  description,
  ctaLabel  = 'Cotizar ahora',
  ctaHref   = `https://wa.me/573054001112?text=Hola,%20quiero%20cotizar%20un%20servicio`,
  badge,
  image,
  stats,
} = Astro.props;
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden" aria-label="Sección principal">
  <!-- Fondo con imagen real + overlay -->
  <div class="absolute inset-0 z-0">
    {image ? (
      <img
        src={image}
        alt="CH Polarizados Medellín"
        class="w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-brand-black via-zinc-900 to-brand-black"></div>
    )}
    <!-- Overlay base oscuro para legibilidad en móvil -->
    <div class="absolute inset-0 bg-brand-black/75"></div>
    <!-- Overlay gradiente desktop: más oscuro a la izquierda -->
    <div class="absolute inset-0 bg-gradient-to-r from-brand-black/90 via-brand-black/60 to-transparent"></div>
    <!-- Patrón de cuadrícula -->
    <div
      class="absolute inset-0 opacity-[0.07]"
      style="background-image: linear-gradient(rgba(197,0,44,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(197,0,44,0.4) 1px, transparent 1px); background-size: 60px 60px;"
    ></div>
    <!-- Glow rojo detrás del contenido izquierdo -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/3 left-0 w-[500px] h-[400px] bg-brand-red/8 rounded-full blur-[120px] -translate-x-1/4"></div>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 w-full">
    <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-center">

      <!-- Columna izquierda: contenido -->
      <div>
        <!-- Badge -->
        {badge && (
          <div class="inline-flex items-center gap-2 bg-brand-red/10 border border-brand-red/30 rounded-full px-4 py-1.5 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-red animate-pulse"></span>
            <span class="text-brand-red text-xs font-semibold uppercase tracking-widest">{badge}</span>
          </div>
        )}

        <!-- Título -->
        <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-white leading-[1.05] mb-4">
          {title}
          <span class="text-brand-red block">{subtitle}</span>
        </h1>

        <!-- Descripción -->
        <p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
          {description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={ctaHref}
            target={ctaHref.startsWith('http') ? '_blank' : '_self'}
            rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="inline-flex items-center justify-center gap-2.5 bg-brand-red hover:bg-brand-red-hover text-white font-bold text-sm px-6 py-3.5 rounded-xl transition-all duration-200 hover:scale-105 active:scale-100 shadow-lg shadow-brand-red/20"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {ctaLabel}
          </a>
          <a
            href="tel:+573054001112"
            class="inline-flex items-center justify-center gap-2 border border-brand-border hover:border-gray-500 text-gray-300 hover:text-white font-medium text-sm px-6 py-3.5 rounded-xl transition-all duration-200"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            305 400 1112
          </a>
        </div>

        <!-- Stats -->
        {stats && stats.length > 0 && (
          <div class="mt-10 pt-10 border-t border-brand-border flex flex-wrap gap-8">
            {stats.map(({ value, label }) => (
              <div>
                <div class="font-display font-black text-3xl text-brand-red">{value}</div>
                <div class="text-gray-400 text-sm mt-0.5">{label}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Columna derecha: tarjetas flotantes (solo desktop) -->
      <div class="hidden lg:flex flex-col items-end gap-4 pr-4">
        <!-- Tarjeta: garantía -->
        <div class="bg-brand-black/70 backdrop-blur-md border border-brand-border rounded-2xl px-5 py-4 flex items-center gap-4 w-64 shadow-xl">
          <div class="w-10 h-10 rounded-xl bg-brand-red/15 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div>
            <p class="text-white text-sm font-bold">Garantía hasta 5 años</p>
            <p class="text-gray-400 text-xs">Nanocerámica Premium</p>
          </div>
        </div>

        <!-- Tarjeta: bloqueo UV -->
        <div class="bg-brand-black/70 backdrop-blur-md border border-brand-border rounded-2xl px-5 py-4 flex items-center gap-4 w-64 shadow-xl">
          <div class="w-10 h-10 rounded-xl bg-brand-red/15 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m8.66-13l-.87.5M4.21 17.5l-.87.5M20.66 17.5l-.87-.5M4.21 6.5l-.87-.5M21 12h-1M4 12H3m15.36-6.36l-.7.7M6.34 17.66l-.7.7M17.66 17.66l-.7-.7M6.34 6.34l-.7-.7"/>
            </svg>
          </div>
          <div>
            <p class="text-white text-sm font-bold">Bloqueo UV 99%</p>
            <p class="text-gray-400 text-xs">Protege interior y pasajeros</p>
          </div>
        </div>

        <!-- Tarjeta: calificación -->
        <div class="bg-brand-black/70 backdrop-blur-md border border-brand-border rounded-2xl px-5 py-4 flex items-center gap-4 w-64 shadow-xl">
          <div class="w-10 h-10 rounded-xl bg-brand-red/15 flex items-center justify-center shrink-0 text-brand-red text-lg font-black">5</div>
          <div>
            <div class="flex gap-0.5 mb-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-3.5 h-3.5 text-brand-red fill-brand-red" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-white text-sm font-bold">+5.000 clientes felices</p>
            <p class="text-gray-400 text-xs">Medellín y área metropolitana</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce-slow hidden md:flex flex-col items-center gap-1">
    <span class="text-gray-500 text-xs">Scroll</span>
    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
