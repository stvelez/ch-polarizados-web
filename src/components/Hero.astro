---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
  badge?: string;
  image?: string;
  stats?: { value: string; label: string }[];
}

const {
  title,
  subtitle,
  description,
  ctaLabel  = 'Cotizar ahora',
  ctaHref   = `https://wa.me/573054001112?text=Hola,%20quiero%20cotizar%20un%20servicio`,
  badge,
  image,
  stats,
} = Astro.props;
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden" aria-label="Sección principal">
  <!-- Fondo con gradiente y overlay -->
  <div class="absolute inset-0 z-0">
    {image ? (
      <img
        src={image}
        alt="CH Polarizados Medellín"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <!-- Fondo abstracto animado cuando no hay imagen -->
      <div class="w-full h-full bg-gradient-to-br from-brand-black via-zinc-900 to-brand-black"></div>
    )}
    <!-- Overlay gradiente -->
    <div class="absolute inset-0 bg-gradient-to-r from-brand-black/95 via-brand-black/80 to-brand-black/40"></div>
    <!-- Patrón de cuadrícula sutil -->
    <div
      class="absolute inset-0 opacity-5"
      style="background-image: linear-gradient(rgba(197,0,44,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(197,0,44,0.3) 1px, transparent 1px); background-size: 60px 60px;"
    ></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 w-full">
    <div class="max-w-2xl">
      <!-- Badge -->
      {badge && (
        <div class="inline-flex items-center gap-2 bg-brand-red/10 border border-brand-red/30 rounded-full px-4 py-1.5 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red animate-pulse"></span>
          <span class="text-brand-red text-xs font-semibold uppercase tracking-widest">{badge}</span>
        </div>
      )}

      <!-- Título -->
      <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-white leading-[1.05] mb-4">
        {title}
        <span class="text-brand-red block">{subtitle}</span>
      </h1>

      <!-- Descripción -->
      <p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
        {description}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={ctaHref}
          target={ctaHref.startsWith('http') ? '_blank' : '_self'}
          rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="inline-flex items-center justify-center gap-2.5 bg-brand-red hover:bg-brand-red-hover text-white font-bold text-sm px-6 py-3.5 rounded-xl transition-all duration-200 hover:scale-105 active:scale-100 shadow-lg shadow-brand-red/20"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {ctaLabel}
        </a>
        <a
          href="tel:+573103557126"
          class="inline-flex items-center justify-center gap-2 border border-brand-border hover:border-gray-500 text-gray-300 hover:text-white font-medium text-sm px-6 py-3.5 rounded-xl transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          310 355 7126
        </a>
      </div>

      <!-- Stats -->
      {stats && stats.length > 0 && (
        <div class="mt-10 pt-10 border-t border-brand-border flex flex-wrap gap-8">
          {stats.map(({ value, label }) => (
            <div>
              <div class="font-display font-black text-3xl text-brand-red">{value}</div>
              <div class="text-gray-400 text-sm mt-0.5">{label}</div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce-slow hidden md:flex flex-col items-center gap-1">
    <span class="text-gray-500 text-xs">Scroll</span>
    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
