---
interface Service {
  title: string;
  description: string;
  href: string;
  icon: string;
  features: string[];
  badge?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  services: Service[];
}

const {
  title = 'Nuestros Servicios',
  subtitle = 'Todo lo que tu vehículo necesita, en un solo lugar',
  services,
} = Astro.props;
---

<section class="py-20 lg:py-28 bg-brand-black" aria-labelledby="services-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header de sección -->
    <div class="text-center mb-14">
      <span class="text-brand-gold text-xs font-bold uppercase tracking-widest">Lo que hacemos</span>
      <h2 id="services-heading" class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-white mt-2 mb-4">
        {title}
      </h2>
      <p class="text-gray-400 text-base max-w-xl mx-auto">{subtitle}</p>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(({ title, description, href, icon, features, badge }) => (
        <a
          href={href}
          class="group relative bg-brand-card border border-brand-border rounded-2xl p-6 hover:border-brand-gold/50 hover:bg-brand-card/80 transition-all duration-300 flex flex-col"
        >
          {badge && (
            <span class="absolute top-4 right-4 bg-brand-gold text-brand-black text-xs font-bold px-2.5 py-1 rounded-full">
              {badge}
            </span>
          )}

          <!-- Ícono -->
          <div class="w-12 h-12 bg-brand-gold/10 rounded-xl flex items-center justify-center mb-5 group-hover:bg-brand-gold/20 transition-colors">
            <span class="text-2xl" role="img" aria-hidden="true">{icon}</span>
          </div>

          <!-- Contenido -->
          <h3 class="font-display font-bold text-xl text-white mb-2 group-hover:text-brand-gold transition-colors">
            {title}
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">{description}</p>

          <!-- Features -->
          <ul class="space-y-2 mt-auto">
            {features.map(feature => (
              <li class="flex items-center gap-2 text-sm text-gray-300">
                <svg class="w-4 h-4 text-brand-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          <!-- Arrow -->
          <div class="mt-6 flex items-center gap-1.5 text-brand-gold text-sm font-semibold">
            Ver más
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
