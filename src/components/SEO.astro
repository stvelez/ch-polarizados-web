---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.jpg',
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://chpolarizados.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl + Astro.url.pathname;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Schema LocalBusiness base (siempre presente)
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "CH Polarizados",
  "image": `${siteUrl}/images/gallery/polarizado-nissan-frontier-01.jpg`,
  "url": siteUrl,
  "telephone": "+573054001112",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Cra. 64c #75a-15, Barrio Caribe",
    "addressLocality": "Medellín",
    "addressRegion": "Antioquia",
    "postalCode": "050015",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 6.274175,
    "longitude": -75.573164
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:30",
      "closes": "18:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.7",
    "reviewCount": "3",
    "bestRating": "5"
  },
  "sameAs": [
    "https://www.instagram.com/chpolarizados"
  ],
  "hasMap": "https://maps.google.com/?q=Cra.+64c+%2375a-15+Medell%C3%ADn",
  "description": "Especialistas en polarizado de vehículos, instalación de sonido, alarmas, bloqueo de puertas, cámaras y eléctrico automotriz en Medellín. Más de 10 años de experiencia.",
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
<link rel="canonical" href={canonicalUrl} />

<!-- Language & Region -->
<meta name="language" content="es" />
<meta name="geo.region" content="CO-ANT" />
<meta name="geo.placename" content="Medellín" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="CH Polarizados - Medellín" />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content="CH Polarizados" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Schema.org LocalBusiness -->
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<!-- Schema adicional por página (FAQPage, Service, etc.) -->
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
