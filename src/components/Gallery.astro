---
interface GalleryItem {
  src: string;
  alt: string;
  category: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: GalleryItem[];
  categories?: string[];
}

const {
  title = 'Galería de Trabajos',
  subtitle = 'Resultados reales de nuestros clientes en Medellín',
  items,
  categories = [],
} = Astro.props;

const allCategories = ['Todos', ...new Set(items.map(i => i.category))];
---

<section class="py-20 lg:py-28 bg-brand-dark" aria-labelledby="gallery-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-10">
      <span class="text-brand-gold text-xs font-bold uppercase tracking-widest">Nuestro trabajo</span>
      <h2 id="gallery-heading" class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-white mt-2 mb-4">
        {title}
      </h2>
      <p class="text-gray-400 text-base max-w-xl mx-auto">{subtitle}</p>
    </div>

    <!-- Filtros de categoría -->
    {allCategories.length > 1 && (
      <div class="flex flex-wrap justify-center gap-2 mb-10" role="tablist" aria-label="Filtrar galería">
        {allCategories.map((cat) => (
          <button
            data-filter={cat}
            class:list={[
              'gallery-filter px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200',
              cat === 'Todos'
                ? 'bg-brand-gold text-brand-black active-filter'
                : 'bg-brand-card border border-brand-border text-gray-300 hover:border-brand-gold/50',
            ]}
            role="tab"
            aria-selected={cat === 'Todos' ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>
    )}

    <!-- Grid de imágenes -->
    {items.length > 0 ? (
      <div id="gallery-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {items.map(({ src, alt, category }) => (
          <div
            class="gallery-item group relative aspect-square overflow-hidden rounded-xl bg-brand-card border border-brand-border cursor-pointer"
            data-category={category}
          >
            <img
              src={src}
              alt={alt}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-3">
              <span class="text-white text-xs font-medium">{alt}</span>
            </div>
            <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="bg-brand-gold text-brand-black text-xs font-bold px-2 py-0.5 rounded-full">{category}</span>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <!-- Placeholder cuando no hay imágenes cargadas -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {Array.from({ length: 8 }).map((_, i) => (
          <div class="aspect-square rounded-xl bg-brand-card border border-brand-border flex flex-col items-center justify-center gap-2">
            <span class="text-3xl opacity-20">📸</span>
            <span class="text-gray-600 text-xs">Foto {i + 1}</span>
          </div>
        ))}
      </div>
    )}

    <!-- CTA galería -->
    <div class="text-center mt-10">
      <a
        href="https://wa.me/573054001112?text=Hola,%20quiero%20ver%20más%20trabajos%20de%20CH%20Polarizados"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-brand-border hover:border-brand-gold/50 text-gray-300 hover:text-white text-sm font-medium px-6 py-3 rounded-xl transition-all"
      >
        Ver más trabajos en WhatsApp
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Filtro de galería por categoría
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
  const galleryItems = document.querySelectorAll<HTMLElement>('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'Todos';

      // Actualizar botones activos
      filterBtns.forEach(b => {
        b.classList.remove('bg-brand-gold', 'text-brand-black', 'active-filter');
        b.classList.add('bg-brand-card', 'border', 'border-brand-border', 'text-gray-300');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('bg-brand-gold', 'text-brand-black', 'active-filter');
      btn.classList.remove('bg-brand-card', 'border-brand-border', 'text-gray-300');
      btn.setAttribute('aria-selected', 'true');

      // Filtrar items
      galleryItems.forEach(item => {
        const cat = item.dataset.category ?? '';
        if (filter === 'Todos' || cat === filter) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
