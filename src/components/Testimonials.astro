---
import type { Testimonial } from '@/data/testimonials';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<section class="py-20 lg:py-28 bg-brand-black" aria-labelledby="testimonials-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-14">
      <span class="text-brand-red text-xs font-bold uppercase tracking-widest">Clientes felices</span>
      <h2 id="testimonials-heading" class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-white mt-2 mb-4">
        Lo que dicen de nosotros
      </h2>
      <div class="flex items-center justify-center gap-1 mb-2">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-5 h-5 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        ))}
      </div>
      <p class="text-gray-500 text-sm">Calificación 5/5 basada en reseñas de clientes reales</p>
    </div>

    <!-- Grid de testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map(({ name, city, service, rating, comment, date }) => (
        <article class="bg-brand-card border border-brand-border rounded-2xl p-6 flex flex-col hover:border-brand-red/30 transition-colors">
          <!-- Stars -->
          <div class="flex items-center gap-0.5 mb-4">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                class:list={['w-4 h-4', i < rating ? 'text-brand-red' : 'text-gray-600']}
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>

          <!-- Comilla decorativa -->
          <svg class="w-6 h-6 text-brand-red/30 mb-3" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>

          <!-- Comentario -->
          <p class="text-gray-300 text-sm leading-relaxed flex-1 mb-5">"{comment}"</p>

          <!-- Autor -->
          <div class="flex items-center justify-between pt-4 border-t border-brand-border">
            <div>
              <p class="text-white font-semibold text-sm">{name}</p>
              <p class="text-gray-500 text-xs">{city}</p>
            </div>
            <div class="text-right">
              <span class="inline-block bg-brand-red/10 text-brand-red text-xs font-medium px-2.5 py-1 rounded-full">
                {service}
              </span>
              {date && <p class="text-gray-600 text-xs mt-1">{date}</p>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
