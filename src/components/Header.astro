---
const navLinks = [
  { label: 'Inicio',       href: '/'            },
  { label: 'Polarizados',  href: '/polarizados' },
  { label: 'Sonido',       href: '/sonido'       },
];

const whatsapp = '+573054001112';
const currentPath = Astro.url.pathname;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-brand-black/80 backdrop-blur-md border-b border-brand-border"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="group" aria-label="CH Polarizados - Inicio">
        <img
          src="/images/logo-blanco.png"
          alt="CH Polarizados"
          class="h-10 w-auto group-hover:opacity-80 transition-opacity"
          loading="eager"
        />
      </a>

      <!-- Nav Desktop -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
        {navLinks.map(({ label, href }) => {
          const isActive =
            href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={[
                'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                isActive
                  ? 'text-brand-red bg-brand-red/10'
                  : 'text-gray-300 hover:text-white hover:bg-white/5',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          );
        })}
      </nav>

      <!-- CTA Desktop -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={`https://wa.me/${whatsapp}?text=Hola,%20quiero%20cotizar%20un%20servicio`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-red text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-red-hover transition-colors"
        >
          Cotizar ahora
        </a>
      </div>

      <!-- Hamburger mobile -->
      <button
        id="menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-300 hover:text-white hover:bg-white/5 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-brand-border bg-brand-dark"
    aria-label="Menú móvil"
  >
    <nav class="px-4 pt-3 pb-4 space-y-1">
      {navLinks.map(({ label, href }) => {
        const isActive =
          href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(href);
        return (
          <a
            href={href}
            class:list={[
              'block px-4 py-3 rounded-lg text-sm font-medium transition-all',
              isActive
                ? 'text-brand-red bg-brand-red/10'
                : 'text-gray-300 hover:text-white hover:bg-white/5',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        );
      })}
      <div class="pt-3 flex flex-col gap-2">
        <a
          href={`https://wa.me/${whatsapp}?text=Hola,%20quiero%20cotizar%20un%20servicio`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center w-full bg-brand-red text-white text-sm font-bold px-4 py-3 rounded-lg"
        >
          Cotizar por WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer para que el contenido no quede debajo del header fijo -->
<div class="h-16 lg:h-20"></div>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn?.setAttribute('aria-expanded', String(!isOpen));
  });

  // Cerrar el menú al hacer click en un link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
