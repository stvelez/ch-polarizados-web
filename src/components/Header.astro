---
const navLinks = [
  { label: 'Inicio',       href: '/'            },
  { label: 'Polarizados',  href: '/polarizados' },
  { label: 'Sonido',       href: '/sonido'       },
];

const phone   = '+573103557126';
const whatsapp = '+573054001112';
const currentPath = Astro.url.pathname;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-brand-black/80 backdrop-blur-md border-b border-brand-border"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group" aria-label="CH Polarizados - Inicio">
        <div class="w-9 h-9 bg-brand-gold rounded-lg flex items-center justify-center font-display font-black text-brand-black text-sm group-hover:scale-105 transition-transform">
          CH
        </div>
        <div class="flex flex-col leading-none">
          <span class="font-display font-bold text-white text-base tracking-tight">CH Polarizados</span>
          <span class="text-xs text-brand-gold font-medium tracking-widest uppercase">Medellín</span>
        </div>
      </a>

      <!-- Nav Desktop -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
        {navLinks.map(({ label, href }) => {
          const isActive =
            href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(href);
          return (
            <a
              href={href}
              class:list={[
                'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                isActive
                  ? 'text-brand-gold bg-brand-gold/10'
                  : 'text-gray-300 hover:text-white hover:bg-white/5',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          );
        })}
      </nav>

      <!-- CTA Desktop -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={`tel:${phone}`}
          class="text-sm text-gray-300 hover:text-white transition-colors flex items-center gap-1.5"
          aria-label="Llamar a CH Polarizados"
        >
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          310 355 7126
        </a>
        <a
          href={`https://wa.me/${whatsapp}?text=Hola,%20quiero%20cotizar%20un%20servicio`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-gold text-brand-black text-sm font-semibold px-4 py-2 rounded-lg hover:bg-amber-400 transition-colors"
        >
          Cotizar ahora
        </a>
      </div>

      <!-- Hamburger mobile -->
      <button
        id="menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-300 hover:text-white hover:bg-white/5 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-brand-border bg-brand-dark"
    aria-label="Menú móvil"
  >
    <nav class="px-4 pt-3 pb-4 space-y-1">
      {navLinks.map(({ label, href }) => {
        const isActive =
          href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(href);
        return (
          <a
            href={href}
            class:list={[
              'block px-4 py-3 rounded-lg text-sm font-medium transition-all',
              isActive
                ? 'text-brand-gold bg-brand-gold/10'
                : 'text-gray-300 hover:text-white hover:bg-white/5',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        );
      })}
      <div class="pt-3 flex flex-col gap-2">
        <a
          href={`tel:${phone}`}
          class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg border border-brand-border text-sm text-gray-300"
        >
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          310 355 7126
        </a>
        <a
          href={`https://wa.me/${whatsapp}?text=Hola,%20quiero%20cotizar%20un%20servicio`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center w-full bg-brand-gold text-brand-black text-sm font-bold px-4 py-3 rounded-lg"
        >
          Cotizar por WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer para que el contenido no quede debajo del header fijo -->
<div class="h-16 lg:h-20"></div>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn?.setAttribute('aria-expanded', String(!isOpen));
  });

  // Cerrar el menú al hacer click en un link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
