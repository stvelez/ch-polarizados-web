---
const address = 'Cra. 64c #75a-15, Barrio Caribe, Medellín';
const mapsUrl = 'https://maps.google.com/?q=Cra.+64c+%2375a-15+Medell%C3%ADn+Colombia';
const embedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.6!2d-75.5948!3d6.2518!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sCH+Polarizados!5e0!3m2!1ses!2sco!4v1';
---

<section class="py-20 lg:py-28 bg-brand-black" aria-labelledby="map-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">

      <!-- Info de contacto -->
      <div class="mb-10 lg:mb-0">
        <span class="text-brand-red text-xs font-bold uppercase tracking-widest">Visítanos</span>
        <h2 id="map-heading" class="font-display font-black text-3xl sm:text-4xl text-white mt-2 mb-6">
          Encuéntranos en<br/>
          <span class="text-brand-red">Medellín</span>
        </h2>

        <div class="space-y-5">
          <!-- Dirección -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-brand-red/10 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm mb-0.5">Dirección</p>
              <p class="text-gray-400 text-sm">{address}</p>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-red text-xs hover:underline mt-1 inline-block"
              >
                Ver en Google Maps →
              </a>
            </div>
          </div>

          <!-- Teléfono -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-brand-red/10 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm mb-0.5">Teléfono</p>
              <a href="tel:+573103557126" class="text-gray-400 text-sm hover:text-white transition-colors">
                +57 310 355 7126
              </a>
            </div>
          </div>

          <!-- WhatsApp -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-[#25D366]/10 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm mb-0.5">WhatsApp</p>
              <a
                href="https://wa.me/573054001112?text=Hola,%20quiero%20una%20cotizaci%C3%B3n"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 text-sm hover:text-white transition-colors"
              >
                +57 305 400 1112
              </a>
            </div>
          </div>

          <!-- Horario -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-brand-red/10 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm mb-1">Horario de atención</p>
              <p class="text-gray-400 text-sm">Lunes a Viernes: 8:00 am – 6:00 pm</p>
              <p class="text-gray-400 text-sm">Sábados: 8:00 am – 2:00 pm</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Mapa -->
      <div class="rounded-2xl overflow-hidden border border-brand-border h-80 lg:h-full min-h-80">
        <iframe
          src={embedUrl}
          width="100%"
          height="100%"
          style="border:0; min-height: 320px;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación CH Polarizados en Medellín"
          class="grayscale hover:grayscale-0 transition-all duration-500"
        ></iframe>
      </div>
    </div>
  </div>
</section>
