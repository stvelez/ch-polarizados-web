---
import Layout from '@/layouts/Layout.astro';
import MapSection from '@/components/MapSection.astro';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "¿Cuánto dura el polarizado de un carro y cómo cuidarlo?",
  "description": "Vida útil del polarizado según el tipo de película, señales de que necesita cambio y consejos de mantenimiento para prolongar su duración al máximo.",
  "datePublished": "2026-01-20",
  "dateModified": "2026-03-28",
  "author": { "@type": "Organization", "name": "CH Polarizados" },
  "publisher": {
    "@type": "Organization",
    "name": "CH Polarizados",
    "logo": { "@type": "ImageObject", "url": "https://chpolarizados.com/favicon.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://chpolarizados.com/blog/cuanto-dura-polarizado-carro-mantenimiento/" }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://chpolarizados.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://chpolarizados.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": "¿Cuánto dura el polarizado?", "item": "https://chpolarizados.com/blog/cuanto-dura-polarizado-carro-mantenimiento/" },
  ],
};
---

<Layout
  title="¿Cuánto dura el polarizado de un carro y cómo cuidarlo? | CH Polarizados"
  description="Vida útil del polarizado nanocerámica, HD y convencional. Señales de cambio y 7 consejos de mantenimiento para que tu polarizado dure el máximo tiempo posible."
  canonical="/blog/cuanto-dura-polarizado-carro-mantenimiento"
  schema={[articleSchema, breadcrumbSchema] as any}
>
  <article class="pt-28 pb-8 bg-brand-black">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="mb-8 text-xs text-gray-500" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-red transition-colors">Inicio</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/blog/" class="hover:text-brand-red transition-colors">Blog</a></li>
          <li aria-hidden="true">›</li>
          <li class="text-gray-400">Durabilidad del polarizado</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-brand-red text-xs font-bold uppercase tracking-widest">Mantenimiento</span>
          <span class="text-gray-600 text-xs">·</span>
          <span class="text-gray-500 text-xs">5 min de lectura</span>
          <span class="text-gray-600 text-xs">·</span>
          <time class="text-gray-500 text-xs" datetime="2026-01-20">20 de enero de 2026</time>
        </div>
        <h1 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-white mb-5 leading-tight">
          ¿Cuánto dura el polarizado de un carro y cómo cuidarlo?
        </h1>
        <p class="text-gray-400 text-base leading-relaxed">
          La durabilidad del polarizado depende principalmente del tipo de película instalada y de cómo la cuidas.
          Con el cuidado adecuado, un buen polarizado puede durar muchos años en perfectas condiciones.
        </p>
      </header>

      <!-- Contenido -->
      <div class="space-y-8 text-gray-300 text-sm leading-relaxed">

        <section>
          <h2 class="font-display font-black text-2xl text-white mb-4">Vida útil según el tipo de polarizado</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {[
              { tipo: 'Nanocerámica', duracion: 'Más de 5 años', garantia: '5 años', color: 'red' },
              { tipo: 'HD', duracion: '3 a 5 años', garantia: '3 años', color: 'gray' },
              { tipo: 'Convencional / Básico', duracion: '1 a 2 años', garantia: 'Variable', color: 'gray' },
            ].map(({ tipo, duracion, garantia, color }) => (
              <div class={`bg-brand-card border rounded-xl p-5 text-center ${color === 'red' ? 'border-brand-red/30' : 'border-brand-border'}`}>
                <p class="text-white font-semibold text-sm mb-2">{tipo}</p>
                <p class={`font-black text-2xl mb-1 ${color === 'red' ? 'text-brand-red' : 'text-white'}`}>{duracion}</p>
                <p class="text-gray-500 text-xs">Garantía: {garantia}</p>
              </div>
            ))}
          </div>
          <p class="mt-4 text-gray-400 text-xs">
            * La vida útil puede variar según las condiciones de exposición solar, zona de parqueo y mantenimiento.
          </p>
        </section>

        <section>
          <h2 class="font-display font-black text-2xl text-white mb-4">Señales de que el polarizado necesita cambio</h2>
          <ul class="space-y-3">
            {[
              { señal: 'Burbujas visibles en la película', desc: 'Las burbujas indican que la película se está despegando. Una vez aparecen, el daño es progresivo.' },
              { señal: 'Tono amarillento o morado', desc: 'La película ha perdido sus propiedades UV y estéticas. Sucede más en polarizados de baja calidad o muy antiguos.' },
              { señal: 'Peeling o desprendimiento en los bordes', desc: 'El adhesivo ha perdido adherencia, generalmente por exposición excesiva al sol o limpieza con productos agresivos.' },
              { señal: 'Rayaduras profundas', desc: 'Si son superficiales y pocas, pueden ser tolerables. Si son extensas, afectan la visibilidad y la estética.' },
              { señal: 'Pérdida notable de oscuridad', desc: 'El polarizado se ha decolorado y ya no ofrece la privacidad ni la protección original.' },
            ].map(({ señal, desc }) => (
              <li class="bg-brand-card border border-brand-border rounded-xl p-4">
                <p class="text-white font-semibold text-sm mb-1">{señal}</p>
                <p class="text-gray-400 text-xs leading-relaxed">{desc}</p>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="font-display font-black text-2xl text-white mb-4">7 consejos para cuidar y prolongar la vida del polarizado</h2>
          <ol class="space-y-4">
            {[
              { n: '1', titulo: 'Espera 3 a 5 días antes de limpiar las ventanas', desc: 'Después de la instalación, la película necesita tiempo para curarse completamente. Limpiar antes puede provocar burbujas o marcas.' },
              { n: '2', titulo: 'Usa paño de microfibra suave', desc: 'Los trapos ásperos o esponjas pueden rayar la película. La microfibra limpia sin dañar la superficie.' },
              { n: '3', titulo: 'Evita limpiadores con amoniaco', desc: 'El amoniaco degrada el adhesivo de la película con el tiempo. Usa limpiadores especiales para polarizado o agua con jabón neutro.' },
              { n: '4', titulo: 'Limpiar siempre de forma suave, sin presión excesiva', desc: 'No frotes con fuerza ni uses estropajos. La limpieza debe ser suave para no desgastar la película.' },
              { n: '5', titulo: 'Evita parquear bajo el sol directo constantemente', desc: 'La exposición constante e intensa al sol acelera el desgaste de la película. Si puedes, parquea bajo sombra o en parqueadero cubierto.' },
              { n: '6', titulo: 'No uses herramientas ni objetos duros cerca de los vidrios', desc: 'Los rasquetes de hielo (poco comunes en Medellín pero válido para otros climas) u objetos duros pueden rayar el polarizado.' },
              { n: '7', titulo: 'Revisa periódicamente los bordes', desc: 'Inspecciona los bordes de la película cada cierto tiempo. Si notas el inicio de un desprendimiento, repáralo a tiempo antes de que avance.' },
            ].map(({ n, titulo, desc }) => (
              <li class="flex gap-4">
                <span class="shrink-0 w-7 h-7 rounded-full bg-brand-red text-white text-xs font-black flex items-center justify-center mt-0.5">{n}</span>
                <div>
                  <p class="text-white font-semibold text-sm mb-1">{titulo}</p>
                  <p class="text-gray-400 text-xs leading-relaxed">{desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section>
          <h2 class="font-display font-black text-2xl text-white mb-4">¿Qué pasa con el polarizado que viene de fábrica?</h2>
          <p>
            Algunos vehículos tienen los vidrios traseros con un tono oscuro que viene integrado en el vidrio mismo
            (no es una película). Ese "polarizado de fábrica" no tiene la misma vida útil que una película: es parte
            del vidrio y no se despega ni se deteriora de la misma manera.
          </p>
          <p class="mt-3">
            Sin embargo, este tono de fábrica no siempre ofrece el mismo nivel de protección UV ni rechazo de calor
            que una buena película de control solar. En ese caso, instalar una película adicional sobre los vidrios
            delanteros (cumpliendo la normativa) puede complementar la protección.
          </p>
        </section>

      </div>

      <!-- CTA -->
      <div class="mt-12 bg-brand-card border border-brand-red/30 rounded-2xl p-7 text-center">
        <p class="text-white font-semibold mb-2">¿Tu polarizado necesita cambio?</p>
        <p class="text-gray-400 text-sm mb-5">Cuéntanos el estado de tu polarizado y te asesoramos gratis.</p>
        <a
          href="https://wa.me/573054001112?text=Hola,%20quiero%20revisar%20si%20mi%20polarizado%20necesita%20cambio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-brand-red hover:bg-brand-red-hover text-white font-bold px-7 py-3.5 rounded-xl transition-all hover:scale-105"
        >
          Consultar por WhatsApp
        </a>
      </div>

      <!-- Artículos relacionados -->
      <nav class="mt-12 pt-8 border-t border-brand-border" aria-label="Artículos relacionados">
        <p class="text-gray-500 text-xs uppercase tracking-widest mb-4">Artículos relacionados</p>
        <div class="space-y-3">
          <a href="/blog/polarizado-nanoceramica-vs-hd-diferencias/" class="flex items-center gap-2 text-gray-300 hover:text-brand-red transition-colors text-sm">
            <svg class="w-4 h-4 text-brand-red shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Polarizado Nanocerámica vs HD: ¿Cuál elegir?
          </a>
          <a href="/blog/cuanto-cuesta-polarizar-carro-medellin/" class="flex items-center gap-2 text-gray-300 hover:text-brand-red transition-colors text-sm">
            <svg class="w-4 h-4 text-brand-red shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            ¿Cuánto cuesta polarizar un carro en Medellín?
          </a>
        </div>
      </nav>

    </div>
  </article>

  <MapSection />
</Layout>
